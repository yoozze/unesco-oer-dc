<?php

/**
 * @file
 * Install / schema update hooks for the Admin module.
 *
 * Use hook_update_N here ONLY for schema changes that must run in strict
 * numeric order (rare). For content / entity data migrations, use
 * admin.post_update.php + updates/*.php instead.
 *
 * Deploy order: config:import, then updatedb (see run.sh --setup).
 *
 * @code
 * function admin_update_10001() {
 *   // Schema-only work, or:
 *   return admin_run_update_script('feature/schema_fix.php');
 * }
 * @endcode
 *
 * @see admin.post_update.php
 * @see updates/README.md
 * @see admin_run_update_script()
 */
