<?php

/**
 * @file
 * Admin theme improvements, hero helpers, and update script runner.
 */

use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\paragraphs\ParagraphInterface;

/**
 * Implements hook_preprocess_page().
 */
function admin_preprocess_page(&$variables) {
    $variables['#attached']['library'][] = 'admin/admin';
}

/**
 * Run an idempotent update script under modules/custom/admin/updates/.
 *
 * @param string $relative
 *   Path relative to the updates/ directory, e.g. "hero/migrate_slides.php".
 *
 * @return string
 *   Status message for Drush / update UI.
 *
 * @throws \RuntimeException
 *   When the script is missing.
 */
function admin_run_update_script(string $relative): string {
    $path = dirname(__FILE__) . '/updates/' . ltrim($relative, '/');
    if (!is_readable($path)) {
        throw new \RuntimeException("Update script not readable: $path");
    }

    $result = include $path;
    if (!is_string($result) || $result === '') {
        return t('Update @script completed.', ['@script' => $relative]);
    }

    return $result;
}

/**
 * Implements hook_form_alter().
 */
function admin_form_alter(&$form, FormStateInterface $form_state, $form_id) {
    $form_object = $form_state->getFormObject();
    if (!$form_object instanceof EntityFormInterface) {
        return;
    }

    $entity = $form_object->getEntity();
    if ($entity->getEntityTypeId() === 'block_content' && $entity->bundle() === 'hero') {
        $form['#validate'][] = 'admin_hero_block_validate_enabled_slides';
        if (isset($form['field_slides']['widget'])) {
            $form['field_slides']['widget']['#after_build'][] = 'admin_hero_slides_featured_autoplay_after_build';
        }
    }
}

/**
 * Mark hero slide media/autoplay fields for admin visibility JS.
 *
 * Conditional Fields cannot evaluate media_library "!empty", so visibility is
 * handled in admin/js/hero-featured-autoplay.js instead.
 */
function admin_hero_slides_featured_autoplay_after_build(array $element, FormStateInterface $form_state) {
    foreach (Element::children($element) as $delta) {
        if (!is_numeric($delta) || empty($element[$delta]['subform'])) {
            continue;
        }

        $subform = &$element[$delta]['subform'];
        if (!isset($subform['field_featured_autoplay'], $subform['field_media'])) {
            continue;
        }

        $subform['#attributes']['class'][] = 'js-hero-slide-subform';
        $subform['field_media']['#attributes']['class'][] = 'js-hero-featured-media';
        $subform['field_featured_autoplay']['#attributes']['class'][] = 'js-hero-featured-autoplay';

        // Widget roots are what Media Library AJAX tends to replace under.
        if (isset($subform['field_media']['widget']) && is_array($subform['field_media']['widget'])) {
            $subform['field_media']['widget']['#attributes']['class'][] = 'js-hero-featured-media';
        }

        if (isset($subform['field_featured_autoplay']['widget']) && is_array($subform['field_featured_autoplay']['widget'])) {
            $subform['field_featured_autoplay']['widget']['#attributes']['class'][] = 'js-hero-featured-autoplay';
        }

        $has_media = admin_hero_slide_subform_has_featured_media($subform['field_media']);
        if ($has_media) {
            $subform['field_featured_autoplay']['#attributes']['class'][] = 'js-hero-featured-autoplay--visible';
            if (isset($subform['field_featured_autoplay']['widget']) && is_array($subform['field_featured_autoplay']['widget'])) {
                $subform['field_featured_autoplay']['widget']['#attributes']['class'][] = 'js-hero-featured-autoplay--visible';
            }
        }
    }

    $element['#attached']['library'][] = 'admin/hero_featured_autoplay';
    return $element;
}

/**
 * Whether the featured media widget currently has a selection.
 */
function admin_hero_slide_subform_has_featured_media(array $field_media): bool {
    $widget = $field_media['widget'] ?? $field_media;
    if (empty($widget['selection']) || !is_array($widget['selection'])) {
        return FALSE;
    }

    foreach (Element::children($widget['selection']) as $delta) {
        if (isset($widget['selection'][$delta]['target_id'])) {
            return TRUE;
        }
    }

    return FALSE;
}

/**
 * Ensures at least one hero slide remains enabled.
 */
function admin_hero_block_validate_enabled_slides(array &$form, FormStateInterface $form_state) {
    /** @var \Drupal\Core\Entity\EntityFormInterface $form_object */
    $form_object = $form_state->getFormObject();
    /** @var \Drupal\block_content\BlockContentInterface $entity */
    $entity = $form_object->buildEntity($form, $form_state);

    if (!$entity->hasField('field_slides')) {
        return;
    }

    $enabled_count = 0;
    foreach ($entity->get('field_slides') as $item) {
        $paragraph = $item->entity;
        if (!$paragraph instanceof ParagraphInterface) {
            continue;
        }

        if (admin_hero_slide_is_enabled($paragraph)) {
            $enabled_count++;
        }
    }

    if ($enabled_count < 1) {
        $form_state->setErrorByName(
            'field_slides',
            t('At least one hero slide must be enabled.')
        );
    }
}

/**
 * Whether a hero slide is enabled (missing/empty = enabled).
 *
 * @param \Drupal\paragraphs\ParagraphInterface $paragraph
 *   Slide paragraph.
 *
 * @return bool
 *   TRUE if enabled.
 */
function admin_hero_slide_is_enabled(ParagraphInterface $paragraph) {
    if (!$paragraph->hasField('field_enabled') || $paragraph->get('field_enabled')->isEmpty()) {
        return TRUE;
    }

    return (bool) $paragraph->get('field_enabled')->value;
}
