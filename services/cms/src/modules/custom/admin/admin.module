<?php

/**
 * @file
 * Admin theme improvements, hero helpers, and update script runner.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;
use Drupal\paragraphs\ParagraphInterface;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_entity_base_field_info_alter().
 *
 * Allow Custom menu link URLs to differ per language (core leaves Link
 * non-translatable, so it never appears on the Content language form).
 *
 * @see https://www.drupal.org/project/drupal/issues/2466553
 */
function admin_entity_base_field_info_alter(array &$fields, EntityTypeInterface $entity_type): void {
    if ($entity_type->id() !== 'menu_link_content' || !isset($fields['link'])) {
        return;
    }

    $fields['link']->setTranslatable(TRUE);
}

/**
 * Implements hook_entity_field_access().
 *
 * Restrict editing of Resource Category to users with the dedicated permission
 * (moderators / administrators). Viewing the field stays public.
 */
function admin_entity_field_access($operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL) {
    if (
        $field_definition->getTargetEntityTypeId() !== 'node'
        || $field_definition->getTargetBundle() !== 'resource'
        || $field_definition->getName() !== 'field_resource_category'
    ) {
        return AccessResult::neutral();
    }

    if ($operation === 'edit') {
        // Neutral when permitted (entity edit access still applies); forbid otherwise.
        // allowedIfHasPermission() alone is not enough — deny is neutral and field
        // edit then falls through to entity-level allow.
        return AccessResult::forbiddenIf(!$account->hasPermission('edit resource category field'))
            ->cachePerPermissions();
    }

    return AccessResult::neutral();
}

/**
 * Implements hook_preprocess_page().
 */
function admin_preprocess_page(&$variables) {
    $variables['#attached']['library'][] = 'admin/admin';
}

/**
 * Implements hook_preprocess_views_view().
 *
 * Hide the Views Data Export feed icon on Content; the CSV control is placed
 * in the bulk-actions bar instead (see admin_form_views_form_content_page_1_alter).
 * Keep the VDE library attached so batch auto-download JS still runs.
 */
function admin_preprocess_views_view(array &$variables): void {
    $view = $variables['view'] ?? NULL;
    if (!$view instanceof ViewExecutable || $view->id() !== 'content') {
        return;
    }

    $variables['feed_icons'] = [];
    $variables['#attached']['library'][] = 'views_data_export/views_data_export';
}

/**
 * Implements hook_form_FORM_ID_alter() for views_form_content_page_1.
 *
 * Adds an outlined CSV export button next to "Apply to selected items". Claro
 * moves header[node_bulk_form] into the sticky bulk_actions_container.
 */
function admin_form_views_form_content_page_1_alter(array &$form, FormStateInterface $form_state): void {
    if (empty($form['header']['node_bulk_form'])) {
        return;
    }

    $query = ['_format' => 'csv'];
    $view = $form_state->getBuildInfo()['args'][0] ?? NULL;
    if ($view instanceof ViewExecutable) {
        $exposed = $view->getExposedInput();
        if (is_array($exposed) && $exposed !== []) {
            // Drop pager; export should cover the full filtered result set.
            unset($exposed['page']);
            $query += $exposed;
        }
    }

    $form['header']['node_bulk_form']['csv_export'] = [
        '#type' => 'container',
        '#attributes' => [
            'class' => [
                'views-bulk-actions__item',
                'content-csv-export',
            ],
        ],
        '#weight' => 100,
        'link' => [
            '#type' => 'link',
            '#title' => t('Export CSV'),
            '#url' => Url::fromRoute('view.content.data_export_1', [], ['query' => $query]),
            '#attributes' => [
                'class' => [
                    'button',
                    'button--small',
                ],
            ],
        ],
    ];
}

/**
 * Content types that expose field_source (Source / publisher).
 */
function admin_content_source_filter_bundles(): array {
    return ['news', 'resource'];
}

/**
 * Implements hook_views_pre_view().
 *
 * Ignore Source / publisher when Content type is not News or Resource.
 */
function admin_views_pre_view(ViewExecutable $view, string $display_id, array &$args): void {
    if ($view->id() !== 'content') {
        return;
    }

    $exposed = $view->getExposedInput();
    if (!is_array($exposed) || !array_key_exists('field_source_value', $exposed)) {
        return;
    }

    $type = '';
    if (isset($exposed['type']) && is_string($exposed['type'])) {
        $type = $exposed['type'];
    }

    if (in_array($type, admin_content_source_filter_bundles(), TRUE)) {
        return;
    }

    unset($exposed['field_source_value']);
    $view->setExposedInput($exposed);
}

/**
 * Implements hook_form_FORM_ID_alter() for views_exposed_form.
 *
 * On Content overview: grid layout for filters; Source / publisher only when
 * News or Resource is selected, with type-scoped publisher autocomplete.
 */
function admin_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
    $view = $form_state->get('view');
    if (!$view instanceof ViewExecutable || $view->id() !== 'content') {
        return;
    }

    $form['#attributes']['class'][] = 'js-content-exposed-form';
    $form['#attached']['library'][] = 'admin/content_exposed_form';

    if (!isset($form['field_source_value'], $form['type']) || !is_array($form['field_source_value'])) {
        return;
    }

    if (!\Drupal::moduleHandler()->moduleExists('news_ingestion')) {
        return;
    }

    $allowed = admin_content_source_filter_bundles();
    $selected_type = admin_content_exposed_type_value($form_state, $view);
    $visible = in_array($selected_type, $allowed, TRUE);

    $form['type']['#attributes']['class'][] = 'js-content-type-filter';

    $form['field_source_value']['#autocomplete_route_name'] = 'news_ingestion.publisher_autocomplete';
    $form['field_source_value']['#attributes']['class'][] = 'form-autocomplete';
    $form['field_source_value']['#attributes']['class'][] = 'js-content-source-input';
    $form['field_source_value']['#wrapper_attributes']['class'][] = 'js-content-source-filter';
    if ($visible) {
        $form['field_source_value']['#wrapper_attributes']['class'][] = 'js-content-source-filter--visible';
    }

    $form['field_source_value']['#after_build'][] = 'admin_content_source_filter_after_build';

    $form['#attached']['library'][] = 'admin/content_source_filter';
    $form['#attached']['drupalSettings']['adminContentSourceFilter'] = [
        'bundles' => array_values($allowed),
        'autocompletePath' => Url::fromRoute('news_ingestion.publisher_autocomplete')->toString(),
    ];
}

/**
 * Reads the exposed Content type value from user input or the view.
 */
function admin_content_exposed_type_value(FormStateInterface $form_state, ViewExecutable $view): string {
    $input = $form_state->getUserInput();
    if (isset($input['type']) && is_string($input['type']) && $input['type'] !== 'All' && $input['type'] !== '') {
        return $input['type'];
    }

    $exposed = $view->getExposedInput();
    if (isset($exposed['type']) && is_string($exposed['type']) && $exposed['type'] !== 'All' && $exposed['type'] !== '') {
        return $exposed['type'];
    }

    return '';
}

/**
 * After-build: append selected bundle as ?type= on the autocomplete path.
 */
function admin_content_source_filter_after_build(array $element, FormStateInterface $form_state): array {
    $classes = $element['#wrapper_attributes']['class'] ?? [];
    if (!in_array('js-content-source-filter--visible', $classes, TRUE)) {
        return $element;
    }

    $view = $form_state->get('view');
    if (!$view instanceof ViewExecutable) {
        return $element;
    }

    $type = admin_content_exposed_type_value($form_state, $view);
    if ($type === '' || !in_array($type, admin_content_source_filter_bundles(), TRUE)) {
        return $element;
    }

    $path = $element['#attributes']['data-autocomplete-path'] ?? '';
    if ($path === '') {
        $path = Url::fromRoute('news_ingestion.publisher_autocomplete')->toString();
    }

    $separator = str_contains($path, '?') ? '&' : '?';
    $element['#attributes']['data-autocomplete-path'] = $path . $separator . 'type=' . rawurlencode($type);

    return $element;
}

/**
 * Implements hook_views_data_export_row_alter().
 *
 * Shorten Action Area labels to numbers only in the Content CSV export
 * (e.g. "Action area 1: capacity building, Action area 3: …" → "1, 3").
 */
function admin_views_data_export_row_alter(array &$row, \Drupal\views\ResultRow $result, \Drupal\views\ViewExecutable $view): void {
    if ($view->id() !== 'content' || $view->current_display !== 'data_export_1') {
        return;
    }

    $key = NULL;
    foreach (['Action Area', 'field_area_of_action'] as $candidate) {
        if (array_key_exists($candidate, $row)) {
            $key = $candidate;
            break;
        }
    }

    if ($key === NULL) {
        return;
    }

    $value = trim(html_entity_decode(strip_tags((string) $row[$key]), ENT_QUOTES | ENT_HTML5, 'UTF-8'));
    if ($value === '') {
        return;
    }

    if (!preg_match_all('/Action area\s+(\d+)/i', $value, $matches)) {
        return;
    }

    $row[$key] = implode(', ', $matches[1]);
}

/**
 * Run an idempotent update script under modules/custom/admin/updates/.
 *
 * @param string $relative
 *   Path relative to the updates/ directory, e.g. "hero/migrate_slides.php".
 *
 * @return string
 *   Status message for Drush / update UI.
 *
 * @throws \RuntimeException
 *   When the script is missing.
 */
function admin_run_update_script(string $relative): string {
    $path = dirname(__FILE__) . '/updates/' . ltrim($relative, '/');
    if (!is_readable($path)) {
        throw new \RuntimeException("Update script not readable: $path");
    }

    $result = include $path;
    if (!is_string($result) || $result === '') {
        return t('Update @script completed.', ['@script' => $relative]);
    }

    return $result;
}

/**
 * Implements hook_form_alter().
 */
function admin_form_alter(&$form, FormStateInterface $form_state, $form_id) {
    $form_object = $form_state->getFormObject();
    if (!$form_object instanceof EntityFormInterface) {
        return;
    }

    $entity = $form_object->getEntity();
    if ($entity->getEntityTypeId() === 'block_content' && $entity->bundle() === 'hero') {
        $form['#validate'][] = 'admin_hero_block_validate_enabled_slides';
        if (isset($form['field_slides']['widget'])) {
            $form['field_slides']['widget']['#after_build'][] = 'admin_hero_slides_conditional_fields_after_build';
        }
    }

    if ($entity->getEntityTypeId() === 'node' && $entity->bundle() === 'oer_observatory') {
        $form['#validate'][] = 'admin_observatory_validate_enabled_views';
    }
}

/**
 * Mark hero slide fields for admin visibility JS.
 *
 * Conditional Fields cannot evaluate media_library "!empty", so media-dependent
 * visibility is handled in admin/js/hero-slide-conditional-fields.js. Featured
 * content media placement is toggled the same way against the autocomplete value.
 */
function admin_hero_slides_conditional_fields_after_build(array $element, FormStateInterface $form_state) {
    foreach (Element::children($element) as $delta) {
        if (!is_numeric($delta) || empty($element[$delta]['subform'])) {
            continue;
        }

        $subform = &$element[$delta]['subform'];
        $subform['#attributes']['class'][] = 'js-hero-slide-subform';

        admin_hero_slide_mark_media_dependent(
            $subform,
            'field_media',
            'field_featured_autoplay',
            'js-hero-featured-media',
            'js-hero-featured-autoplay',
            'js-hero-featured-autoplay--visible'
        );

        admin_hero_slide_mark_media_dependent(
            $subform,
            'field_background',
            'field_background_opacity',
            'js-hero-background-media',
            'js-hero-background-opacity',
            'js-hero-background-opacity--visible'
        );

        admin_hero_slide_mark_media_dependent(
            $subform,
            'field_background',
            'field_background_fit',
            'js-hero-background-media',
            'js-hero-background-fit',
            'js-hero-background-fit--visible'
        );

        admin_hero_slide_mark_featured_content_media($subform);
    }

    $element['#attached']['library'][] = 'admin/hero_slide_conditional_fields';
    return $element;
}

/**
 * Attach JS classes for Featured content → Featured content media visibility.
 */
function admin_hero_slide_mark_featured_content_media(array &$subform): void {
    if (!isset($subform['field_featured_content'], $subform['field_featured_content_media'])) {
        return;
    }

    // Use the existing field wrappers (#attributes), not extra prefix/suffix divs.
    $subform['field_featured_content']['#attributes']['class'][] = 'js-hero-featured-content';
    $subform['field_featured_content_media']['#attributes']['class'][] = 'js-hero-featured-content-media';

    if (!admin_hero_slide_subform_has_featured_content($subform['field_featured_content'])) {
        return;
    }

    $subform['field_featured_content_media']['#attributes']['class'][] = 'js-hero-featured-content-media--visible';
}

/**
 * Whether the featured content autocomplete currently has a selection.
 */
function admin_hero_slide_subform_has_featured_content(array $field): bool {
    $widget = $field['widget'] ?? $field;
    foreach (Element::children($widget) as $delta) {
        if (!is_numeric($delta)) {
            continue;
        }

        $target = $widget[$delta]['target_id'] ?? NULL;
        if (is_array($target)) {
            $value = $target['#default_value'] ?? $target['#value'] ?? NULL;
            if (admin_hero_slide_featured_content_value_is_set($value)) {
                return TRUE;
            }
        } elseif (admin_hero_slide_featured_content_value_is_set($target)) {
            return TRUE;
        } elseif (admin_hero_slide_featured_content_value_is_set($widget[$delta]['#default_value'] ?? NULL)) {
            return TRUE;
        }
    }

    return FALSE;
}

/**
 * Whether an entity-reference autocomplete value represents a selection.
 *
 * @param mixed $value
 *   Entity, id, autocomplete label string, or empty.
 */
function admin_hero_slide_featured_content_value_is_set($value): bool {
    if ($value instanceof \Drupal\Core\Entity\EntityInterface) {
        return TRUE;
    }

    if (is_int($value) || (is_string($value) && ctype_digit($value))) {
        return (int) $value > 0;
    }

    if (is_string($value)) {
        $value = trim($value);
        return $value !== '' && preg_match('/\(\d+\)\s*$/', $value);
    }

    return FALSE;
}

/**
 * Attach JS classes for a media library field and a dependent form field.
 */
function admin_hero_slide_mark_media_dependent(
    array &$subform,
    string $media_field,
    string $dependent_field,
    string $media_class,
    string $dependent_class,
    string $visible_class
): void {
    if (!isset($subform[$media_field], $subform[$dependent_field])) {
        return;
    }

    $subform[$media_field]['#attributes']['class'][] = $media_class;
    $subform[$dependent_field]['#attributes']['class'][] = $dependent_class;

    if (isset($subform[$media_field]['widget']) && is_array($subform[$media_field]['widget'])) {
        $subform[$media_field]['widget']['#attributes']['class'][] = $media_class;
    }

    if (isset($subform[$dependent_field]['widget']) && is_array($subform[$dependent_field]['widget'])) {
        $subform[$dependent_field]['widget']['#attributes']['class'][] = $dependent_class;
    }

    if (!admin_hero_slide_subform_has_media_selection($subform[$media_field])) {
        return;
    }

    $subform[$dependent_field]['#attributes']['class'][] = $visible_class;
    if (isset($subform[$dependent_field]['widget']) && is_array($subform[$dependent_field]['widget'])) {
        $subform[$dependent_field]['widget']['#attributes']['class'][] = $visible_class;
    }
}

/**
 * Whether a media library widget currently has a selection.
 */
function admin_hero_slide_subform_has_media_selection(array $field_media): bool {
    $widget = $field_media['widget'] ?? $field_media;
    if (empty($widget['selection']) || !is_array($widget['selection'])) {
        return FALSE;
    }

    foreach (Element::children($widget['selection']) as $delta) {
        if (isset($widget['selection'][$delta]['target_id'])) {
            return TRUE;
        }
    }

    return FALSE;
}

/**
 * Ensures at least one hero slide remains enabled.
 */
function admin_hero_block_validate_enabled_slides(array &$form, FormStateInterface $form_state) {
    /** @var \Drupal\Core\Entity\EntityFormInterface $form_object */
    $form_object = $form_state->getFormObject();
    /** @var \Drupal\block_content\BlockContentInterface $entity */
    $entity = $form_object->buildEntity($form, $form_state);

    if (!$entity->hasField('field_slides')) {
        return;
    }

    $enabled_count = 0;
    foreach ($entity->get('field_slides') as $item) {
        $paragraph = $item->entity;
        if (!$paragraph instanceof ParagraphInterface) {
            continue;
        }

        if (admin_hero_slide_is_enabled($paragraph)) {
            $enabled_count++;
        }
    }

    if ($enabled_count < 1) {
        $form_state->setErrorByName(
            'field_slides',
            t('At least one hero slide must be enabled.')
        );
    }
}

/**
 * Whether a hero slide is enabled (missing/empty = enabled).
 *
 * @param \Drupal\paragraphs\ParagraphInterface $paragraph
 *   Slide paragraph.
 *
 * @return bool
 *   TRUE if enabled.
 */
function admin_hero_slide_is_enabled(ParagraphInterface $paragraph) {
    if (!$paragraph->hasField('field_enabled') || $paragraph->get('field_enabled')->isEmpty()) {
        return TRUE;
    }

    return (bool) $paragraph->get('field_enabled')->value;
}

/**
 * Ensures at least one observatory view remains enabled.
 */
function admin_observatory_validate_enabled_views(array &$form, FormStateInterface $form_state) {
    /** @var \Drupal\Core\Entity\EntityFormInterface $form_object */
    $form_object = $form_state->getFormObject();
    /** @var \Drupal\node\NodeInterface $entity */
    $entity = $form_object->buildEntity($form, $form_state);

    if (!$entity->hasField('field_observatory_views')) {
        return;
    }

    $enabled_count = 0;
    foreach ($entity->get('field_observatory_views') as $item) {
        $paragraph = $item->entity;
        if (!$paragraph instanceof ParagraphInterface) {
            continue;
        }

        if (admin_observatory_view_is_enabled($paragraph)) {
            $enabled_count++;
        }
    }

    if ($enabled_count < 1) {
        $form_state->setErrorByName(
            'field_observatory_views',
            t('At least one observatory view must be enabled.')
        );
    }
}

/**
 * Whether an observatory view is enabled (missing/empty = enabled).
 *
 * @param \Drupal\paragraphs\ParagraphInterface $paragraph
 *   Observatory view paragraph.
 *
 * @return bool
 *   TRUE if enabled.
 */
function admin_observatory_view_is_enabled(ParagraphInterface $paragraph) {
    if (!$paragraph->hasField('field_enabled') || $paragraph->get('field_enabled')->isEmpty()) {
        return TRUE;
    }

    return (bool) $paragraph->get('field_enabled')->value;
}
