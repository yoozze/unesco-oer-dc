{#
/**
 * @file
 * Theme override for hero block (multi-slide slider).
 */
#}
<section{{attributes.addClass('c-hero').setAttribute('data-options',slider_options|default({})|json_encode)}}>
	{{ title_prefix }}
	{% if label %}
		<h2{{title_attributes}} class="visually-hidden">{{ label }}</h2>
	{% endif %}
	{{ title_suffix }}
	<div class="c-hero__slider">
		{% block content %}
			{{ content.field_slides }}
		{% endblock %}
	</div>
	<div class="c-hero__autoplay-progress" hidden aria-hidden="true">
		<div class="c-hero__autoplay-progress-bar"></div>
	</div>
</section>
