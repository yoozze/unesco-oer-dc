{#
/**
 * @file
 * Theme override for a 'form' element.
 *
 * Available variables
 * - attributes: A list of HTML attributes for the wrapper element.
 * - children: The child elements of the form.
 *
 * @see template_preprocess_form()
 */
#}
<form{{ attributes.addClass([
    'c-form',
    'c-form--comment',
    'c-form--' ~ attributes.id|clean_class,
]) }}>
    {% if element.comment_preview %}
        <div class="c-form__preview">
            <h2 class="c-form__preview-title">{{ 'Preview'|t }}</h2>
            {{ element.comment_preview }}
        </div>
    {% endif %}

    {{ element.form_build_id }}
    {{ element.form_token }}
    {{ element.form_id }}

    {{ element.langcode }}
    {{ element.subject }}
    {{ element.comment_body }}

    {{ element.footer }}
    {{ element.actions }}
</form>

