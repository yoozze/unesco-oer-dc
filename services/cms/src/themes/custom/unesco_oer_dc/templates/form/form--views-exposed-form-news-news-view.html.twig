{#
/**
 * @file
 * News listing exposed filters: primary search + key filters; rest in advanced.
 */
#}
{% set classes = [
    'c-form',
    'c-form--views-exposed-form',
    'c-form--'~attributes.id|clean_class
] %}
<form{{attributes.addClass(classes)}}>
    {{ element.form_id }}
    {{ element.form_build_id }}
    {{ element.form_token }}

    <div class="c-form__group">
        <div class="c-form__group-primary">
            {{ element.search }}
            {% if element.official_only %}
                {{ element.official_only }}
            {% endif %}
            <div class="c-form__group-primary-filters">
                {% if element.field_area_of_action_target_id %}
                    {{ element.field_area_of_action_target_id }}
                {% endif %}
                {% if element.field_region_target_id %}
                    {{ element.field_region_target_id }}
                {% endif %}
                {% if element.field_language_target_id %}
                    {{ element.field_language_target_id }}
                {% endif %}
            </div>
        </div>
        {{ element.secondary }}
    </div>

    <div class="c-form__actions">
        {{ element.actions.submit }}
        <button class="c-button c-button--text" type="reset">
            {{ svg_icon('delete', 'c-button__leading-icon') }}
            <span class="c-button__label">{{ 'Clear'|t }}</span>
        </button>
    </div>
</form>
