{#
/**
 * @file
 * Theme override for a field.
 *
 * @see field.html.twig
 */
#}
{% set item = items|first %}
<div>
    <dt>{{ svg_icon('location-on') }} <span>{{ label }}</span></dt>
    <dd>
        {% if venue_url %}
            <a href="{{ venue_url }}" target="{{ venue_external ? '_blank' : '_self' }}"{{ venue_external ? ' rel="noopener noreferrer"' : '' }}>
                <span>{{ item.content }}</span>
                {{ venue_external ? svg_icon('open-in-new') : '' }}
            </a>
        {% else %}
            <span>{{ item.content }}</span>
        {% endif %}
    </dd>
</div>
