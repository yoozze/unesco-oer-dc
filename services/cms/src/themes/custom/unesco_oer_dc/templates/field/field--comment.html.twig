{#
/**
 * @file
 * Theme override for comment fields.
 *
 * @see template_preprocess_field()
 * @see comment_preprocess_field()
 */
#}
<section{{ attributes.addClass('c-comments') }}>
    {% if comments and not label_hidden %}
        {{ title_prefix }}
        <h2{{ title_attributes.addClass('c-comments__title') }}>{{ label }}</h2>
        {{ title_suffix }}
    {% endif %}

    {% if comments %}
        <div class="c-comments__list">
            {{ comments }}
        </div>
    {% endif %}

    {% if comment_form %}
        <div class="c-comments__form">
            <h2{{ content_attributes.addClass('c-comments__form-title') }}>{{ 'Add new comment'|t }}</h2>
            {{ comment_form }}
        </div>
    {% endif %}
</section>
