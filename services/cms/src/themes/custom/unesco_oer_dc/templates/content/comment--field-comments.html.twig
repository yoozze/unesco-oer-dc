{#
/**
 * @file
 * Theme override for default field comments.
 *
 * @see template_preprocess_comment()
 */
#}
<article{{ attributes.addClass(['c-comment', 'js-comment']) }}>
    {% if parent %}
        <p class="visually-hidden">{{ parent }}</p>
    {% endif %}

    <div{{ content_attributes.addClass('c-comment__content') }}>
        <div class="c-comment__header">
            <div class="c-comment__avatar" aria-hidden="true">
                {{ author_picture }}
            </div>

            <div class="c-comment__heading">
                {{ title_prefix }}
                {% if title %}
                    <div class="c-comment__title-row">
                        <h3{{ title_attributes.addClass('c-comment__title') }}>{{ title|striptags }}</h3>
                        {#
                            Keep the placeholder empty for render cache. History JS
                            reveals and labels it when the comment is new for the viewer.
                            Keep this mark immediately after the title so only the
                            #new jump anchor (inserted by JS) can appear between them.
                        #}
                        <mark class="c-comment__new hidden" data-comment-timestamp="{{ new_indicator_timestamp }}"></mark>
                    </div>
                {% else %}
                    <mark class="c-comment__new hidden" data-comment-timestamp="{{ new_indicator_timestamp }}"></mark>
                {% endif %}
                {{ title_suffix }}

                <div class="c-comment__meta">
                    <span class="c-comment__author">
                        {% if author_url %}
                            <a href="{{ author_url }}">{{ author_display_name }}</a>
                        {% else %}
                            {{ author_display_name }}
                        {% endif %}
                    </span>
                    <span class="c-comment__sep" aria-hidden="true"></span>
                    <time class="c-comment__date-time" datetime="{{ new_indicator_timestamp|date('Y-m-d\\TH:i:s') }}">
                        <span>{{ new_indicator_timestamp|date('j F Y') }}</span>
                        <span class="c-comment__sep" aria-hidden="true"></span>
                        <span>{{ new_indicator_timestamp|date('H:i') }}</span>
                    </time>
                </div>
            </div>
        </div>

        <div class="c-comment__body">
            {{ content.comment_body[0] }}
        </div>

        {% if content.links %}
            <div class="c-comment__footer">
                <div class="c-comment__actions">
                    {{ content.links }}
                </div>
            </div>
        {% endif %}
    </div>
</article>
