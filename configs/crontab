# Host crontab template — website backups (NOT Drupal cron).
#
# This file is for the HOST user's crontab (installed by scripts/install_crontab.sh).
# It schedules full-site archive dumps and backup retention on the server filesystem.
#
# Do NOT confuse with services/cms/config/crontab, which runs INSIDE the CMS
# Docker container and only triggers Drupal/drush cron (queue, updates, etc.).
#
# Placeholders /path/to/app and /path/to/log are replaced by install_crontab.sh.
# Managed block markers must stay intact so reinstalls update only this section.
#
# m h  dom mon dow   command

# BEGIN unesco-oer-dc
# Daily full website backup at 2:00 AM.
0 2 * * * /bin/bash /path/to/app/run.sh --archive-dump >> /path/to/log/backup.log 2>&1

# Daily backup retention at 3:00 AM (7 days daily + Sunday weekly long-term).
0 3 * * * /bin/bash /path/to/app/scripts/backup_retention.sh >> /path/to/log/retention.log 2>&1
# END unesco-oer-dc
